/* =========================
   PAGE (titre / nav / texte)
========================= */
html{
    font-size: 100%;
}

@media (min-width: 1400px){
    body{
        font-size: 18px;
    }
}

body{
    font-family: "Segoe UI", sans-serif;
    background: #f4f7fb;
    color: #1f2a44;
    font-size: 17px;
    margin: 0;
    padding: 24px;
}

.hint{
    max-width: 1400px;
    margin: 0 auto 16px auto;
    padding: 10px 12px;
    border: 1px dashed rgba(0,0,0,.18);
    border-radius: 10px;
    background: #fff;
    color: #2c3e50;
    font-size: 14px;
}

/* =========================
   LAYOUT
========================= */
.layout-wrapper{
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
}

.project-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(260px,1fr));
    gap:20px;
    align-items:stretch; /* clé */
}


@media (max-width: 1200px){
    .project-grid{ grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 900px){
    .project-grid{ grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px){
    .project-grid{ grid-template-columns: 1fr; }
}

/* =========================
   TILE
========================= */
.project-tile{
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    min-height: 210px;
    padding: 20px;
    border: 1px solid #c9d7ff;
    box-shadow: 0 4px 14px rgba(31, 42, 68, 0.06);
    background:#fff;
    transition:.15s;
    border-radius: 14px;
}


.project-tile:hover{ filter: brightness(.992); }
.project-tile:active{ transform: translateY(1px); }

.tile-head{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    flex:1; /* prend tout l’espace disponible */
    text-align:center;
}


.tile-title{
    font-weight:700;
    margin-bottom:6px;

    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;

    overflow:hidden;
}


.tile-subtext{
    font-size:14px;
    color:#555;

    display:-webkit-box;
    -webkit-line-clamp:3;
    -webkit-box-orient:vertical;

    overflow:hidden;
    margin-bottom: 20px;
}

/* =========================
   ACTIONS
========================= */
.tile-btn.is-disabled,
[data-modal-action].is-disabled {
    opacity: .45;
    cursor: not-allowed;
    pointer-events: auto;
}

.tile-actions{
    display: flex;
    gap: 10px;
    justify-content: center;
    align-items: center;
}

.tile-btn{
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border: 1px solid rgba(0,0,0,0.14);
    background: #fff;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 0;
    cursor: pointer;
}

.tile-btn:hover{ filter: brightness(0.98); }

.tile-btn img{
    width: 18px;
    height: 18px;
    display: block;
    object-fit: contain;
    pointer-events: none;
}

/* =========================
   EXPAND
========================= */
.tile-expand{
    width: 100%;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed rgba(0,0,0,0.15);

    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height .25s ease, opacity .2s ease;
}

.tile-expand.open{
    opacity: 1;
}

/* Optional: contenu injecté */
.project-detail{
    font-size: 14px;
    color: #2c3e50;
}
.project-detail .detail-lines{
    display: grid;
    gap: 6px;
    margin-bottom: 10px;
}
.project-detail .detail-desc{
    line-height: 1.45;
}

/* ===
CATEGORIE SELECTION
 ==== */

.category-selection{
    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    text-align: center;
    flex-direction: row;
    justify-content: center;
    margin-top: 25px;
    margin-bottom: 25px;
}

.cat-pill{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:10px 16px;
    border-radius:10px;
    border:1px solid rgba(47,47,134,.18);

    background:#2f2f86;
    color:#fff;

    font-weight:600;
    font-size:15px;
    line-height:1;

    cursor:pointer;
    user-select:none;
    white-space:nowrap;

    transition:filter .15s ease, transform .15s ease, background .15s ease, color .15s ease, box-shadow .15s ease, border-color .15s ease;
}

.cat-pill:hover{
    filter:brightness(1.08);
    transform:translateY(-1px);
}

/* ✅ ACTIVE = inversion + ring */
.cat-pill.is-active{
    background:#fff;                 /* inversion */
    color:#2f2f86;                   /* inversion */
    border-color:rgba(47,47,134,.35);
    box-shadow:0 0 0 3px rgba(47,47,134,.20);
    filter:none;
    transform:none;
}

.category-bar{
    max-width: 1400px;
    margin: 25px auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.category-selection{
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    flex: 1;
    margin: 0;
}



/* =================
   HEADER
================= */

.page-header{
    max-width: 1400px;
    margin: 0 auto 18px auto;
    padding: 1.5rem 2rem;
    border-radius: 20px;
    box-shadow: 2px 2px 2px 2px #312c2c;
    background: #ffffff;
    border-bottom: 1px solid #e0e0e0;
}

/* Ligne du haut */
.header-top{
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Logo */
.logo{
    height: 45px;
    display: block;
}

/* Partie droite : nom + admin */
.header-right{
    display: flex;
    align-items: center;
    gap: 14px;
}

/* Nom projet */
.project-name{
    font-size: 1.1rem;
    font-weight: 600;
    color: #2c3e50;
}

/* Bouton admin */
.admin-link{
    display: inline-flex;
    align-items: center;
    gap: 6px;

    text-decoration: none;
    font-weight: 600;
    font-size: 14px;

    padding: 8px 14px;
    border-radius: 10px;
    border: 1px solid rgba(0,0,0,.12);
    background: #fff;
    color: #2c3e50;
    box-shadow: 0 2px 6px rgba(0,0,0,.06);
    transition: filter .15s ease, transform .15s ease;
}

.admin-link:hover{ filter: brightness(.97); }
.admin-link:active{ transform: translateY(1px); }

/* Ligne du bas */
.header-bottom{
    margin-top: 18px;
    text-align: center; /* ✅ centre le titre */
}

.page-title{
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    color: #2c3e50;
}

/* =========================
   MODAL
========================= */
.modal{
    position: fixed;
    inset: 0;
    display: none;
    z-index: 9999;
}
.modal.is-open{ display: block; }

.modal-backdrop{
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.55);
}

.modal-dialog{
    position: relative;
    width: min(900px, calc(100% - 32px));
    margin: 5vh auto;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,.25);
    overflow: hidden;
}

.modal-close{
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,.12);
    background: #fff;
    cursor: pointer;
    font-size: 18px;
    color: black;
    padding: 4px;
    font-weight: bolder;
}

.modal-header{
    padding: 18px 18px 12px 18px;
    border-bottom: 1px solid rgba(0,0,0,.08);
}

.modal-title{
    font-weight: 800;
    color: #2c3e50;
    font-size: 18px;
    line-height: 1.25;
    text-align: center;
}

.modal-subtext{
    margin-top: 8px;
    font-size: 14px;
    color: #2c3e50;
    opacity: .9;
    text-align: center;
}

.modal-actions{
    margin-top: 12px;
    display: flex;
    justify-content: center;
    gap: 10px;
}

.modal-body{
    padding: 16px 18px 18px 18px;
    max-height: 70vh;
    overflow: auto;
}

#modal-description{
    font-size: 14px;
    color: #2c3e50;
    line-height: 1.5;
}
.modal-actions .tile-btn.is-active {
    outline: 2px solid rgba(0, 0, 0, 0.15);
    transform: translateY(-1px);
}

/* ===== Tile feedback states ===== */

.project-tile{
    position: relative;
    transition: transform .12s ease, box-shadow .12s ease, filter .12s ease, border-color .12s ease;
}

/* Hover / focus: "ça se clique" */
.project-tile:hover{
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0,0,0,.10);
}

.project-tile:active{
    transform: translateY(-1px);
}

/* Focus clavier (accessibilité) */
.project-tile:focus-within{
    outline: 3px solid rgba(52,152,219,.25);
    outline-offset: 3px;
}

/* Etat actif (quand la modal est ouverte pour cette tuile) */
.project-tile.is-active{
    border-color: rgba(52,152,219,.8);
    box-shadow: 0 14px 30px rgba(0,0,0,.12);
}

/* Etat loading */
.project-tile.is-loading{
    pointer-events: none;     /* évite double clic */
    filter: grayscale(.15);
    opacity: .85;
}

/* Overlay loading */
.project-tile.is-loading::after{
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 12px;      /* adapte si ton tile a un autre radius */
    background: rgba(255,255,255,.65);
}

/* Spinner */
.project-tile.is-loading::before{
    content: "";
    position: absolute;
    top: 12px;
    right: 12px;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    border: 2px solid rgba(0,0,0,.15);
    border-top-color: rgba(52,152,219,.9);
    animation: tileSpin .8s linear infinite;
    z-index: 2;
}

@keyframes tileSpin{
    to{ transform: rotate(360deg); }
}

/* Petite étiquette "Chargement..." (optionnel) */
.project-tile.is-loading .tile-title::after{
    content: " • chargement…";
    font-weight: 600;
    color: rgba(0,0,0,.55);
    font-size: 12px;
}



/* =========================
   MODAL CONTENT (sections)
   (Contact / Info 1 / Info 2)
========================= */

/* Titre/valeur réutilisés dans la modal */
.modal-body .card-section{
    margin: 0 0 14px 0;
}

.modal-body .label{
    font-weight: 800;
    font-size: 14px;
    color: #2c3e50;
    margin-bottom: 6px;
    text-align: left;
}

.modal-body .value{
    font-size: 14px;
    color: #2c3e50;
    line-height: 1.35;
}

.modal-body .muted{
    color: rgba(44,62,80,.65);
    font-size: 13px;
}

/* Bloc HTML (TinyMCE) compact dans la modal */
.modal-body .wysiwyg--compact{
    margin-top: 10px;
    padding: 12px;
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 12px;
    background: #fbfcfd;
}

/* Typo basique pour le HTML injecté */
.modal-body .wysiwyg--compact :first-child{ margin-top: 0; }
.modal-body .wysiwyg--compact :last-child{ margin-bottom: 0; }

.modal-body .wysiwyg--compact p{
    margin: .55rem 0;
}

.modal-body .wysiwyg--compact ul,
.modal-body .wysiwyg--compact ol{
    margin: .55rem 0 .55rem 1.2rem;
}

.modal-body .wysiwyg--compact li{
    margin: .25rem 0;
}

.modal-body .wysiwyg--compact img{
    max-width: 100%;
    height: auto;
    border-radius: 10px;
}

/* Petites séparations si tu utilises <hr> dans le JS */
.modal-body hr{
    border: 0;
    border-top: 1px solid rgba(0,0,0,.08);
    margin: 14px 0;
}

/* si le projet ouvre la "description détaillée" */
#modal-description :first-child{ margin-top: 0; text-align: center; }
#modal-description :last-child{ margin-bottom: 0; }
#modal-description img{ max-width: 100%; height: auto; border-radius: 10px; }


/* =========================
   SECTION TITLES (modal)
========================= */

.section-title{
    font-size: 18px;
    font-weight: 800;
    color: #2c3e50;
    letter-spacing: 1px;
}

.section-title--center{
    text-align: center;
    font-size: 20px;
}

/* Séparation visuelle propre */
.modal-body hr{
    border: 0;
    border-top: 1px solid rgba(0,0,0,.08);
}

/* === FOOTER */

.page-footer {
    margin-top: 70px;
    padding: 20px;
    background: #ffffff;
    border-top: 1px solid #e5e7eb;

    display: flex;
    justify-content: center;
    align-items: center;

    color: #6b7280;

    font-size: 0.8rem;
    opacity: 0.8;
}

.footer-content {
    display: flex;
    align-items: center;
    gap: 10px;
}

.footer-separator {
    opacity: 0.4;
}

/* =========================
   FLOATING CALENDAR BUTTON
========================= */

.floating-calendar-btn{
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;

    padding: 12px 16px;
    border-radius: 14px;

    background: #2f2f86;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;

    box-shadow: 0 8px 22px rgba(0,0,0,.12);
    border: 1px solid rgba(255,255,255,.15);

    transition: transform .15s ease, filter .15s ease, box-shadow .15s ease;
}

.floating-calendar-btn:hover{
    filter: brightness(1.08);
    box-shadow: 0 12px 28px rgba(0,0,0,.18);
}

.floating-calendar-btn:active{
    transform: translateY(1px);
}